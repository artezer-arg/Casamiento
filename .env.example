# -------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS FIREBIRD SQL (NUBE)
# -------------------------------------------------------------
# Cambiá estos datos por las credenciales de tu servidor de Firebird en la nube:

FIREBIRD_HOST=tu-servidor-firebird.com
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/ruta/en/servidor/casamiento.fdb
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey

# -------------------------------------------------------------
# INTEGRACIÓN DE GOOGLE SHEETS
# -------------------------------------------------------------
# Si preferís configurar la URL del Google Apps Script por variable de entorno:
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycb.../exec
